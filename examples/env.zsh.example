# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/env.zsh.
# DOTFILES_LOCAL_DIR can select a different directory before .zshrc loads.
# This file runs BEFORE shared paths/plugins, unlike ~/.zshrc-local.

# Optional locations. Defaults use HOME, installed brew, and available commands.
# export ZSH="$HOME/.oh-my-zsh"
# export ZSH_CUSTOM="$ZSH/custom"
# export ASDF_DATA_DIR="$HOME/.asdf"
# export BUN_INSTALL="$HOME/.bun"
# export FZF_BASE="/path/to/fzf"
# DOTFILES_BREW_PREFIX="/path/to/homebrew"  # Empty string disables brew detection.
# DOTFILES_EXTRA_PATH=("$HOME/bin")
# DOTFILES_USER_PATHS=()  # Disable the default home-relative bin directories.
# DOTFILES_ASDF_SCRIPT="/path/to/legacy/asdf.sh"  # Only legacy asdf needs this.

# An empty plugin array or theme is supported. Missing plugins are skipped.
# ZSH_THEME=bira
# DOTFILES_ZSH_PLUGINS=(git ssh-agent zsh-autosuggestions fzf)
# DOTFILES_SSH_IDENTITIES=(id_ed25519)
# export EDITOR=nvim
# DOTFILES_LOCALE=en_US.UTF-8  # Use a locale installed on this machine.

# Native local config selection (files must exist and stay outside this repo).
# export ACKRC="$DOTFILES_LOCAL_DIR/ackrc"
# export HTOPRC="$DOTFILES_LOCAL_DIR/htoprc"

# asdf environment overrides also override project .tool-versions pins.
# Prefer a local ~/.tool-versions for machine defaults; use these deliberately.
# export ASDF_NODEJS_VERSION=system

# Select AWS credentials/profiles via private AWS config; never put keys here.
# export AWS_PROFILE=default
# export AWS_REGION=us-east-1
# DOTFILES_EC2_NAME="your-local-instance-tag"
